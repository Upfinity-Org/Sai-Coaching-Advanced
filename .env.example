# Copy this file to ".env" and fill in the two values from your Supabase project:
# Supabase Dashboard -> Project Settings -> API
#
# These are safe to expose in a browser bundle: the anon key only grants what
# your Row Level Security policies allow (see supabase/schema.sql). It is NOT
# an admin/service-role secret.

VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key
